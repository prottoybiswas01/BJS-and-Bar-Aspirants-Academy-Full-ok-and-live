{
  "version": 2,
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "crons": [
    {
      "path": "/api/crons/sync-subtitles",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server.js"
    },
    {
      "src": "/sw.js",
      "dest": "client/sw.js",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "client/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "client/manifest.json"
    },
    {
      "src": "/pwa-192x192.png",
      "dest": "client/pwa-192x192.png"
    },
    {
      "src": "/pwa-512x512.png",
      "dest": "client/pwa-512x512.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "client/apple-touch-icon.png"
    },
    {
      "src": "/robots.txt",
      "dest": "client/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "client/sitemap.xml"
    },
    {
      "src": "/google(.*).html",
      "dest": "client/google$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      }
    }
  ]
}
