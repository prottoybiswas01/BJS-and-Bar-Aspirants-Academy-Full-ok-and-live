{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*",
    "scripts/**/*",
    "test_*.js"
  ],
  "exclude": [
    "node_modules",
    "client",
    "dist",
    ".vercel"
  ]
}
